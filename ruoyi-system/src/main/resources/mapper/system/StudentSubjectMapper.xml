<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StudentSubjectMapper">

    <resultMap type="StudentSubject" id="StudentSubjectResult">
    	<id     property="id"                      column="id"                      />
        <result property="studentId"               column="student_id"               />
        <result property="subjectId"               column="subject_id"               />
        <result property="teacherId"               column="teacher_id"               />
        <result property="subjectHours"            column="subject_hours"            />
        <result property="subjectRemainingHours"   column="subject_remaining_hours"   />
        <result property="subjectName"             column="subject_name"             />
        <result property="teacherName"             column="teacher_name"             />
        <result property="createTime"              column="create_time"              />
    </resultMap>
    
    <sql id="selectStudentSubjectVo">
        select ss.id, ss.student_id, ss.subject_id, ss.teacher_id, ss.subject_hours, ss.subject_remaining_hours, ss.create_time,
               s.subject_name, t.teacher_name
        from edu_student_subject ss
        left join edu_subject s on ss.subject_id = s.id
        left join edu_teacher t on ss.teacher_id = t.id
    </sql>
    
    <select id="selectStudentSubjectById" parameterType="Long" resultMap="StudentSubjectResult">
        <include refid="selectStudentSubjectVo"/>
        where ss.id = #{id}
    </select>
    
    <select id="selectStudentSubjectList" parameterType="StudentSubject" resultMap="StudentSubjectResult">
        <include refid="selectStudentSubjectVo"/>
        <where>
			<if test="studentId != null">
				AND ss.student_id = #{studentId}
			</if>
			<if test="subjectId != null">
				AND ss.subject_id = #{subjectId}
			</if>
			<if test="teacherId != null">
				AND ss.teacher_id = #{teacherId}
			</if>
		</where>
    </select>
    
    <select id="selectStudentSubjectByStudentId" parameterType="Long" resultMap="StudentSubjectResult">
        <include refid="selectStudentSubjectVo"/>
        where ss.student_id = #{studentId}
    </select>
    
    <select id="checkUnique" parameterType="StudentSubject" resultType="int">
        select count(1) from edu_student_subject where student_id = #{studentId} and subject_id = #{subjectId}
    </select>
    
    <insert id="insertStudentSubject" parameterType="StudentSubject">
        insert into edu_student_subject (
			student_id,
			subject_id,
			teacher_id,
			subject_hours,
			subject_remaining_hours,
 			create_time
        )values(
			#{studentId},
			#{subjectId},
			#{teacherId},
			#{subjectHours},
			#{subjectRemainingHours},
 			sysdate()
		)
    </insert>
	 
    <update id="updateStudentSubject" parameterType="StudentSubject">
        update edu_student_subject 
        <set>
            <if test="subjectId != null">subject_id = #{subjectId},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="subjectHours != null">subject_hours = #{subjectHours},</if>
            <if test="subjectRemainingHours != null">subject_remaining_hours = #{subjectRemainingHours},</if>
        </set>
        where id = #{id}
    </update>
    
    <update id="updateSubjectRemainingHours" parameterType="StudentSubject">
        update edu_student_subject 
        set subject_remaining_hours = subject_remaining_hours - #{cancelHours}
        where student_id = #{studentId} and subject_id = #{subjectId}
    </update>
	
    <delete id="deleteStudentSubjectById" parameterType="Long">
        delete from edu_student_subject where id = #{id}
    </delete>
    
    <delete id="deleteStudentSubjectByStudentId" parameterType="Long">
        delete from edu_student_subject where student_id = #{studentId}
    </delete>
    
    <delete id="deleteStudentSubjectBySubjectId" parameterType="Long">
        delete from edu_student_subject where subject_id = #{subjectId}
    </delete>
    
    <select id="selectStudentSubjectByStudentAndSubject" parameterType="Map" resultMap="StudentSubjectResult">
        <include refid="selectStudentSubjectVo"/>
        where ss.student_id = #{studentId} and ss.subject_id = #{subjectId}
    </select>
    
</mapper>